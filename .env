# ==============================================================================
# FLOWFORGE MASTER ENVIRONMENT FILE
# Place this file in the same directory as docker-compose.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AZURE KEY VAULT
# ------------------------------------------------------------------------------
# We use this to pull the 6 secrets you already stored: azure-foundry-key, 
# azure-storage-connection-string, entra-client-secret, internal-api-key, 
# jwt-secret, smtp-password.
AZURE_KEYVAULT_URL="https://flowforge-kv-prod.vault.azure.net/"

# ------------------------------------------------------------------------------
# 2. AZURE MANAGED DATABASES
# ------------------------------------------------------------------------------
# These feed into Project, Task, Auth, and Analysis services.
# Replace <YOUR_POSTGRES_SERVER_NAME> and <YOUR_REDIS_SERVER_NAME>.
DATABASE_URL="postgresql+asyncpg://noelmc:Niamc%4012345@<YOUR_POSTGRES_SERVER_NAME>.postgres.database.azure.com:5432/flowforge"
REDIS_URL="rediss://:ZKJ1Dd67bSFyOuYJ-fScq9QAj9tiHAiNiAZCAB2gViA=@<YOUR_REDIS_SERVER_NAME>.redis.cache.windows.net:6380"

# ------------------------------------------------------------------------------
# 3. ENTRA ID (AZURE AD) CONFIGURATION
# ------------------------------------------------------------------------------
# The Tenant ID and Client ID for your Entra Application Registration.
ENTRA_TENANT_ID="bed24716-6a89-4b1d-96ff-3522f4dfa9c1"
ENTRA_CLIENT_ID="7cd2b208-eee0-40be-b2c5-7254a73b6b18"

# (Optional but required for Auth-Service RBAC if you map groups)
# Copy these Object IDs from Entra ID > Groups.
ENTRA_GROUP_PLATFORM_ADMIN="f88b087f-2718-4597-8fb3-7d9a33a4cacd"
ENTRA_GROUP_ORG_OWNER="9ad27d09-b855-4886-9c12-9d0781f0d354"
ENTRA_GROUP_MANAGER="cc5a18c3-b9fa-4b85-a3b0-4f6f50691498"
ENTRA_GROUP_MEMBER="a37d3b93-88a3-40c5-8b15-f904b7552311"

# ------------------------------------------------------------------------------
# 4. AZURE AI FOUNDRY (Analysis Service)
# ------------------------------------------------------------------------------
# The endpoint URL for the AI Summarization agent.
# (The key is already in Key Vault)
AZURE_FOUNDRY_ENDPOINT="https://capstone-project-resource.services.ai.azure.com/api/projects/capstone-project"

# ------------------------------------------------------------------------------
# 5. NEXT.JS FRONTEND (Build-time variables)
# ------------------------------------------------------------------------------
# Replace <VM_IP_OR_DOMAIN> with the public IP address of your Azure VM.
NEXT_PUBLIC_ENTRA_CLIENT_ID="${ENTRA_CLIENT_ID}"
NEXT_PUBLIC_ENTRA_TENANT_ID="${ENTRA_TENANT_ID}"
NEXT_PUBLIC_ENTRA_REDIRECT_URI="http://20.63.50.51:3000"
PUBLIC_IP="20.63.50.51"

# ------------------------------------------------------------------------------
# 6. EMAIL CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
# Required for notification-worker (password is in Key Vault).
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USERNAME="bloodymaryy77@gmail.com"
SMTP_FROM_NAME="FlowForge Notifications"
