# ╔═══════════════════════════════════════════════════════════════════════╗
# ║          FlowForge — Environment Configuration Template             ║
# ║  Copy this file to .env and fill in the values for your deployment  ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ── Core Secrets ─────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE-ME-use-a-strong-random-string-min-32-chars
INTERNAL_API_KEY=CHANGE-ME-use-a-strong-random-string

# ── Public IP / Domain ───────────────────────────────────────────────────────
PUBLIC_IP=flowforge.fun
FRONTEND_URL=https://flowforge.fun

# ── Database ─────────────────────────────────────────────────────────────────
# Docker Compose uses the postgres service; update for Azure PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flowforge

# Per-service DATABASE_URL (set in each service's .env)
# AUTH:      postgresql+asyncpg://postgres:postgres@postgres:5432/auth_db
# PROJECT:   postgresql+asyncpg://postgres:postgres@postgres:5432/project_db
# TASK:      postgresql+asyncpg://postgres:postgres@postgres:5432/task_db
# ANALYTICS: postgresql+asyncpg://postgres:postgres@postgres:5432/analytics_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Microsoft Entra ID (Azure AD) ────────────────────────────────────────────
# Leave empty to disable Entra ID and use email/password fallback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Security Group Object IDs (from Azure AD > Groups > Object ID)
ENTRA_GROUP_PLATFORM_ADMIN=
ENTRA_GROUP_ORG_OWNER=
ENTRA_GROUP_MANAGER=
ENTRA_GROUP_MEMBER=

# ── Azure AI Foundry ─────────────────────────────────────────────────────────
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_KEY=
AZURE_FOUNDRY_DEPLOYMENT=summary-agent
AZURE_FOUNDRY_USE_MANAGED_IDENTITY=false

# OpenAI fallback (if not using Azure AI Foundry)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Azure Blob Storage ───────────────────────────────────────────────────────
# Option 1: Connection string (for Docker Compose / VM)
AZURE_STORAGE_CONNECTION_STRING=

# Option 2: Managed Identity (for AKS)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_USE_MANAGED_IDENTITY=false
AZURE_STORAGE_CONTAINER=flowforge-reports

# ── Azure Key Vault ──────────────────────────────────────────────────────────
# If set, secrets are loaded from Key Vault (overrides .env values)
AZURE_KEYVAULT_URL=

# ── SMTP (Email) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=FlowForge
SMTP_FROM_EMAIL=

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_REDIRECT_URI=https://flowforge.fun

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Default Organization ─────────────────────────────────────────────────────
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
