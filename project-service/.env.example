# project-service environment
# REQUIRED
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/project_db

# OPTIONAL
REDIS_URL=redis://redis:6379
APP_PORT=8002
FRONTEND_URL=http://localhost:3000
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
AUTH_SERVICE_URL=http://auth-service:8001
TASK_SERVICE_URL=http://task-service:8003

# Internal service security (REQUIRED, must match all services)
INTERNAL_API_KEY=change-this-in-production

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=FlowForge
SMTP_FROM_EMAIL=noreply@flowforge.local
