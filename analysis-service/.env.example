# analysis-service environment
# REQUIRED
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/analytics_db

# OPTIONAL
REDIS_URL=redis://redis:6379
APP_PORT=8004
STREAM_CONSUMER_GROUP=analytics-group
STREAM_CONSUMER_NAME=analytics-worker-1
INTERNAL_API_KEY=change-this-in-production

# AI provider (at least one recommended, falls back to basic summary if neither set)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-35-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
