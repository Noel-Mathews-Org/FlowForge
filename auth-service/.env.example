# auth-service environment
# REQUIRED
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/auth_db
JWT_SECRET=change-this-in-production

# OPTIONAL (with defaults)
REDIS_URL=redis://redis:6379
JWT_EXPIRY_HOURS=1
REFRESH_TOKEN_DAYS=7
APP_PORT=8001
FRONTEND_URL=http://localhost:3000
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Internal service security (REQUIRED, must match all services)
INTERNAL_API_KEY=change-this-in-production

# Email (optional, invite emails disabled if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=FlowForge
SMTP_FROM_EMAIL=noreply@flowforge.local
